# ==============================================================================
# ALIF FRIENDS 12 — PRODUCTION ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================
# Copy this file to .env.local for local development.
# For Vercel / Netlify deployment: configure these in Project Settings > Environment Variables.
# NEVER commit real secret keys, private keys, or passwords to git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SECURITY & URL
# ------------------------------------------------------------------------------
JWT_SECRET="replace-with-a-random-64-character-cryptographic-secret-key"
NEXT_PUBLIC_SITE_URL="https://aliffriends.vercel.app"

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & STORAGE (Source of truth for CMS & Class Finance)
# ------------------------------------------------------------------------------
# Supabase Project URL (Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Publishable / Anon Key (Safe for browser client)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOi..."

# Supabase Secret / Service Role Key (Server-only privileged backend operations)
# NEVER expose to browser JavaScript!
SUPABASE_SECRET_KEY="eyJhbGciOi..."

