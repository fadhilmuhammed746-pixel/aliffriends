# ==============================================================================
# ALIF FRIENDS 12 — PRODUCTION ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================
# Copy this file to .env.local for local development.
# For Vercel deployment: configure these in Vercel Project Settings > Environment Variables.
# NEVER commit real secret keys, private keys, or passwords to git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SECURITY & URL
# ------------------------------------------------------------------------------
JWT_SECRET="replace-with-a-random-64-character-cryptographic-secret-key"
NEXT_PUBLIC_SITE_URL="https://aliffriends.vercel.app"

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & STORAGE (Source of truth for CMS & Class Finance)
# ------------------------------------------------------------------------------
# Supabase Project URL (Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase Publishable / Anon Key (Safe for browser client)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOi..."

# Supabase Secret / Service Role Key (Server-only privileged backend operations)
# NEVER expose to browser JavaScript!
SUPABASE_SECRET_KEY="eyJhbGciOi..."

# ------------------------------------------------------------------------------
# 3. FIREBASE CLIENT CONFIGURATION (Analytics, Auth, Firestore, Storage)
# Found in Firebase Console > Project Settings > General > Your Apps (Web App)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef..."
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# ------------------------------------------------------------------------------
# 4. FIREBASE ADMIN SDK (Server-Side Privileged Operations & JWT Bridge)
# Found in Firebase Console > Project Settings > Service accounts > Generate new private key
# ------------------------------------------------------------------------------
# Option A: Discrete Environment Variables (Recommended for Vercel)
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option B: Full JSON Service Account String or Base64 (Alternative)
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"..."}'
